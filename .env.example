# Google Gemini API Key
# Get yours here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# HeyGen keys (optional; used for realistic avatars)
# Get yours here: https://app.heygen.com/settings?nav=API
# Note: These are separate credentials in some setups; if you only have one, set the one you have.
HEYGEN_API_KEY=your_heygen_api_key_here
LIVE_AVATAR_API_KEY=your_live_avatar_api_key_here

# OpenAI fallback (optional; used when Gemini is unavailable)
# If set, JODA can respond via text (and the web UI will use browser TTS/STT).
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5

# Ollama fallback (optional; used if Gemini and OpenAI are unavailable)
# Ollama must be running on the host (default: http://127.0.0.1:11434).
# Set models as a comma-separated list; JODA will try them in order.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS=gpt-oss,deepseek-r1

# browser-use (optional)
# If you install browser-use per https://docs.browser-use.com/quickstart, you can route tasks via /browse.
# Note: JODA will still work without this (it falls back to the built-in Playwright web agent).
# BROWSER_USE_ENABLED=true
BROWSER_USE_PROVIDER=openai
BROWSER_USE_OPENAI_MODEL=gpt-o3

# JODA local /browse skills injection (optional)
# Comma-separated list of skill IDs/names to always include, or '*' for all.
JODA_BROWSER_SKILLS=

# Daily ads automation (scheduler -> n8n/zapier)
# If set, the daily_ads pipeline will POST the trend brief to these webhooks.
N8N_WEBHOOK_URL=
ZAPIER_WEBHOOK_URL=

# NanoBanana (Gemini image) configuration
# Image preview (NanoBanana): gemini-2.5-flash-image-preview
# NanoBanana Pro: gemini-3-pro-image-preview
NANOBANANA_MODEL=gemini-2.5-flash-image-preview
NANOBANANA_PRO_MODEL=gemini-3-pro-image-preview

# Fireworks.ai API (image fallback) - https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=

# AI/ML API - Seedance video generation - https://aimlapi.com/app/keys
AIML_API_KEY=

# Together.ai API (image fallback) - https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Fal.ai API (image & video fallback) - https://fal.ai/dashboard/keys
FAL_KEY=

# Replicate API (image & video fallback) - https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Hugging Face API (image & video fallback) - https://huggingface.co/settings/tokens
HF_TOKEN=

# Social platform credentials (used by n8n/zapier or direct posting integrations)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ORG_ID=

# Agent Zero (docker)
AGENT_ZERO_IMAGE=agent0ai/agent-zero
AGENT_ZERO_BASE_PORT=50001
AGENT_ZERO_NAME_PREFIX=joda-agent-zero

# MCP (Model Context Protocol)
# By default, JODA reads `backend/mcp_servers.json`.
# If you've already configured MCP servers via `codex mcp add ...`, you can import them:
# JODA_MCP_IMPORT_CODEX=1
# JODA_CODEX_CONFIG_PATH=/root/.codex/config.toml
# JODA_MCP_CODEX_ENABLE_BY_DEFAULT=0
# JODA_MCP_CODEX_AUTO_ENABLE=pubmed,context7

# Context7 (optional; documentation lookup via MCP)
CONTEXT7_API_KEY=

# Frontend -> backend Socket.IO connection (optional).
# If unset, the UI connects to the same hostname it was loaded from (recommended for VPS),
# falling back to the default VPS IP in `src/App.jsx`.
# VITE_SOCKET_URL=http://72.62.165.102:8765
# VITE_BACKEND_HOST=72.62.165.102
# VITE_BACKEND_PORT=8765

# Telegram relay via Clawdbot (optional)
# Requires a working clawdbot gateway configured for Telegram.
# JODA_TELEGRAM_ENABLED=1
# JODA_TELEGRAM_TARGET=@your_channel_or_chat_id
#
# If `clawdbot` is not on PATH, point JODA at your local checkout:
# CLAWDBOT_CMD="node /root/clawdbot/dist/entry.js"
